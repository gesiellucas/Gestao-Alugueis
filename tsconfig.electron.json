{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": [
    "electron/**/*.ts",
    "database/schema/sqlite.ts",
    "database/client/sqlite.ts",
    "database/ipc/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
