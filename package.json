{
  "name": "gc-locamoto-pro",
  "private": true,
  "version": "0.0.1",
  "description": "Gestão de alugueis de motos",
  "author": "Gesiel Lucas",
  "homepage": "https://github.com/gesiellucas/gc-locamoto-pro",
  "license": "MIT",
  "main": "dist/electron/main/index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "electron:compile": "tsc --project tsconfig.electron.json",
    "electron:dev": "concurrently --kill-others \"npm run dev\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development npx --no electron dist/electron/main/index.js\"",
    "electron:build": "npm run build && npm run electron:compile && electron-builder --config electron-builder.config.js",
    "electron:build:win": "npm run electron:build -- --win",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "db:generate": "drizzle-kit generate && drizzle-kit generate --config=drizzle.pg.config.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.studio.config.ts",
    "db:push:supabase": "drizzle-kit push --config=drizzle.pg.config.ts"
  },
  "dependencies": {
    "@google/genai": "^1.40.0",
    "@supabase/supabase-js": "^2.98.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-devtools": "^5.91.3",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.563.0",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@libsql/client": "^0.17.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.9",
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8",
    "pg": "^8.20.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.15",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.8.2",
    "wait-on": "^8.0.5"
  }
}